<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- بطاقة الإعدادات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعدادات الـ Webhook"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <!-- رابط الـ Webhook -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رابط الـ Webhook URL:"
                android:textColor="#333333"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etWebhookUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:hint="https://yourdomain.com/webhook.php"
                android:layout_marginBottom="12dp" />

            <!-- الـ Secret Token (مخفي برمز كلمة السر) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الـ Secret Token:"
                android:textColor="#333333"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSecretToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="CliqSecret2026"
                android:layout_marginBottom="12dp" />

            <!-- اسم المحفظة -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم المحفظة (Wallet Name):"
                android:textColor="#333333"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etWalletName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="MainWallet"
                android:layout_marginBottom="20dp" />

            <!-- زر الحفظ -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="حفظ الإعدادات" />

        </LinearLayout>

        <!-- زر منح الإذن -->
        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="منح إذن قراءة الرسائل" />

    </LinearLayout>
</ScrollView>
