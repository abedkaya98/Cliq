<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- إعدادات الـ Webhook -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12sp"
                android:text="إعدادات الـ Webhook"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWebhookUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Webhook URL"
                android:inputType="textUri"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSecretToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Secret Token"
                android:inputType="textPassword"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="حفظ الإعدادات والقواعد" />
        </LinearLayout>

        <!-- زر إضافة بطاقة جديدة -->
        <Button
            android:id="@+id/btnAddCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#27AE60"
            android:text="+ إضافة بطاقة بنك جديدة" />

        <!-- الحاوية التي ستنزل فيها البطاقات ديناميكياً -->
        <LinearLayout
            android:id="@+id/cardsContainerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="منح إذن قراءة الرسائل" />

    </LinearLayout>
</ScrollView>
