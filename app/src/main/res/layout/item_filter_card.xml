<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- زر حذف البطاقة -->
        <Button
            android:id="@+id/btnDeleteCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:backgroundTint="#E74C3C"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 1. اختيار اسم المرسل -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. اختر مرسل الرسالة (البنك):"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerBank"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp" />

        <!-- 2. اختيار رسالة نموذجية -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. اختر رسالة نموذجية من هذا المرسل:"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSampleSms"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- 3. أزرار الفحص والإرسال -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnTestMatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#3498DB"
                android:text="تحليل محلي"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSendTestWebhook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#27AE60"
                android:text="إرسال تجريبي للسيرفر"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- مكان عرض نتيجة الاختيار -->
        <TextView
            android:id="@+id/tvTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="اختر رسالة واضغط على الاختبار..."
            android:textColor="#666666"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
