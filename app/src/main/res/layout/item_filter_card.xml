<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:elevation="4dp"
    android:radius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- زر حذف البطاقة -->
        <Button
            android:id="@+id/btnDeleteCard"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="left"
            android:background="#E74C3C"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- 1. اختيار اسم المرسل -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. اختر مرسل الرسالة (البنك):"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerBank"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp" />

        <!-- 2. اختيار رسالة نموذجية -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. اختر رسالة نموذجية من هذا المرسل:"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSampleSms"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- 3. زر اختبار وتحليل الرسالة -->
        <Button
            android:id="@+id/btnTestMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#3498DB"
            android:text="اختبار وتحليل الرسالة المختارة"
            android:textSize="13sp" />

        <!-- مكان عرض نتيجة الاختيار -->
        <TextView
            android:id="@+id/tvTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="اختر رسالة واضغط على زر التحليل للاختبار..."
            android:textColor="#666666"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
